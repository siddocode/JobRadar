# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret Key (Required in production - generate a secure random string)
JWT_SECRET=jobradar_jwt_secure_random_key_change_me_in_production

# Frontend Client URL (Required for verification links & emails, e.g. https://your-project.vercel.app)
APP_URL=http://localhost:5173

# MongoDB Connection (MongoDB Atlas connection string)
# Remember to whitelist 0.0.0.0/0 in MongoDB Atlas -> Network Access for Render deployments
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobradar?retryWrites=true&w=majority

# Automatic In-App Background Sync (optional, default: false or true)
ENABLE_CRON=true
CRON_SCHEDULE=0 */6 * * *

# Brevo (Sendinblue) Transactional Email Configuration (Required for real email OTPs and welcome emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=siddocode@gmail.com
BREVO_SENDER_NAME=JobRadar

# Google Places API Key (optional, for company office enrichment)
GOOGLE_PLACES_API_KEY=

# Adzuna API Credentials (optional, for Adzuna job aggregator)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
