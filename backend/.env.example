# Server Configuration
PORT=5000

# MongoDB Connection (MongoDB Atlas or Local)
# Replace with your own MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/jobradar

# Automatic In-App Background Sync (optional, default: false)
ENABLE_CRON=false
CRON_SCHEDULE=0 */6 * * *

# Google Places API Key (optional, for company office enrichment)
GOOGLE_PLACES_API_KEY=

# Adzuna API Credentials (optional, for Adzuna job aggregator)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=siddocode@gmail.com
BREVO_SENDER_NAME=JobRadar
APP_URL=http://localhost:5173
